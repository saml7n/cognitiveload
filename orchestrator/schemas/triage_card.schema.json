{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TriageCard",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "classification": {
      "enum": ["bug", "feature-request", "question", "unclear"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "summary": {
      "type": "string",
      "maxLength": 1000
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 5
    },
    "affected_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "suggested_labels": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "suggested_priority": {
      "enum": ["low", "medium", "high", "critical"]
    }
  },
  "required": ["schema_version", "classification", "confidence", "summary"]
}
